diff --git a/.github/scripts/build-ipa.sh b/.github/scripts/build-ipa.sh
index fbc6ebd..c3072ce 100755
--- a/.github/scripts/build-ipa.sh
+++ b/.github/scripts/build-ipa.sh
@@ -90,6 +90,37 @@ if not common:
 print("App and embedded extensions retain common App Groups with ad-hoc signatures.")
 VERIFY_ENTITLEMENTS
 
+# Validate the built product is a real arm64 iPad-capable device build. These
+# are hard failures: a simulator/x86 slice or an iPhone-only family would mean
+# the IPA cannot install on an iPad Air (M3).
+echo "==> Validating device build (arm64, iPad family, deployment target)"
+binary="$app/GestaltX"
+plist="$app/Info.plist"
+
+archs="$(lipo -archs "$binary" 2>/dev/null || echo "")"
+echo "    Architectures: ${archs:-unknown}"
+case " $archs " in
+  *" arm64 "*) : ;;
+  *) echo "Error: app binary is not arm64 (got: ${archs:-none})" >&2; exit 1 ;;
+esac
+
+# UIDeviceFamily 2 == iPad. The app targets "1,2" (iPhone + iPad).
+families="$(/usr/libexec/PlistBuddy -c 'Print :UIDeviceFamily' "$plist" 2>/dev/null | tr -d ' ' | tr '\n' ',')"
+echo "    UIDeviceFamily: ${families:-unset}"
+if ! grep -q '2' <<< "$families"; then
+  echo "Error: Info.plist UIDeviceFamily does not include iPad (2)" >&2
+  exit 1
+fi
+
+min_os="$(/usr/libexec/PlistBuddy -c 'Print :MinimumOSVersion' "$plist" 2>/dev/null || echo "unknown")"
+echo "    MinimumOSVersion: $min_os"
+sdk_name="$(/usr/libexec/PlistBuddy -c 'Print :DTSDKName' "$plist" 2>/dev/null || echo "unknown")"
+echo "    Built against SDK: $sdk_name"
+case "$sdk_name" in
+  *simulator*) echo "Error: packaged a Simulator build; expected a device (iphoneos) build" >&2; exit 1 ;;
+esac
+echo "    Device build validated."
+
 ipa="$out/GestaltX_$version.ipa"
 # Keep an existing package until the replacement is complete.
 (cd "$stage" && zip -qry "$stage/GestaltX_$version.ipa" Payload)
diff --git a/.github/workflows/ipad-air-m3-build.yml b/.github/workflows/ipad-air-m3-build.yml
new file mode 100644
index 0000000..1dd7860
--- /dev/null
+++ b/.github/workflows/ipad-air-m3-build.yml
@@ -0,0 +1,74 @@
+name: Build IPA (iPad Air M3, hosted runner)
+
+# Portable, manually-triggered build on a GitHub-hosted macOS runner. The main
+# build.yml targets a self-hosted `xcode-27` label; this workflow lets anyone
+# build an ad-hoc, re-signable IPA from a fork with no custom infrastructure.
+#
+# It reuses the same .github/scripts/build-ipa.sh, which now validates that the
+# packaged app is an arm64, iPad-capable (UIDeviceFamily 2) device build before
+# zipping — so a successful run means a real iPad-installable IPA, not a claim.
+
+on:
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: Branch, tag, or commit to build
+        type: string
+        default: feature/ipad-air-m3
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ipad-air-m3-build-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    runs-on: macos-15
+    timeout-minutes: 45
+    steps:
+      - name: Checkout source
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref }}
+          fetch-depth: 1
+
+      - name: Select latest stable Xcode
+        uses: maxim-lobanov/setup-xcode@v1
+        with:
+          xcode-version: latest-stable
+
+      - name: Show toolchain
+        run: |
+          xcodebuild -version
+          swift --version || true
+
+      - name: Restore native device console
+        id: gxconsole-cache
+        uses: actions/cache@v4
+        with:
+          path: Native/DeviceConsole/build/GXDeviceConsole.xcframework
+          key: gxconsole-${{ runner.os }}-${{ hashFiles('Native/DeviceConsole/build-xcframework.sh', 'Native/DeviceConsole/Cargo.toml', 'Native/DeviceConsole/Cargo.lock', 'Native/DeviceConsole/src/**', 'Native/DeviceConsole/vendor/**') }}
+
+      - name: Build native device console
+        if: steps.gxconsole-cache.outputs.cache-hit != 'true'
+        run: |
+          rustup target add aarch64-apple-ios aarch64-apple-ios-sim
+          command -v nasm >/dev/null || brew install nasm
+          cd Native/DeviceConsole
+          ./build-xcframework.sh
+
+      - name: Build and validate IPA
+        id: build
+        run: |
+          export BUILD_DATE="$(date -u +%F)"
+          .github/scripts/build-ipa.sh "$RUNNER_TEMP/ipa"
+
+      - name: Upload IPA artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: GestaltX-iPadAirM3-${{ steps.build.outputs.version }}
+          path: ${{ steps.build.outputs.ipa }}
+          if-no-files-found: error
+          retention-days: 14
